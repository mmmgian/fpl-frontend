# Copy to .env.local for local development. All values are optional.

# Classic league to show. Defaults to 467763 (The Lobster League, 2026/27).
LEAGUE_ID=467763

# fpl-backend base URL (used only for history snapshots and the cron job).
# Defaults to https://fpl-backend-poix.onrender.com
API_BASE=http://localhost:8000

# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes when this is set.
CRON_SECRET=

# Must match the backend's SNAPSHOT_SECRET if the backend has one.
SNAPSHOT_SECRET=
